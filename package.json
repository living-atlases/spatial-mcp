{
  "name": "spatial-mcp",
  "version": "0.1.0",
  "description": "POC: experimental MCP server for routine ALA spatial-service admin tasks (adding layers, tasks, areas, analyses)",
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "spatial-mcp": "dist/stdio.js",
    "spatial-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript reference/3.1.0/openapi.json -o src/api.gen.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "start": "node --import tsx src/stdio.ts",
    "start:http": "node --import tsx src/http.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "openapi-fetch": "^0.17.0",
    "tsx": "^4.23.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
